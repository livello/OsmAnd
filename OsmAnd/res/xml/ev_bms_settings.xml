<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:title="@string/ev_bms_plugin_name">

	<PreferenceCategory
		android:key="ev_bms_devices"
		android:layout="@layout/preference_category_with_descr"
		android:title="@string/ev_bms_devices" />

	<Preference
		android:key="ev_bms_address"
		android:layout="@layout/preference_with_descr"
		android:persistent="false"
		android:title="@string/ev_bms_jbd_title"
		tools:summary="@string/ev_bms_status_not_selected" />

	<net.osmand.plus.settings.preferences.ListPreferenceEx
		android:key="ev_bms_protocol"
		android:layout="@layout/preference_with_descr"
		android:title="@string/ev_bms_protocol" />

	<Preference
		android:key="ev_controller_address"
		android:layout="@layout/preference_with_descr"
		android:persistent="false"
		android:title="@string/ev_bms_fardriver_title"
		tools:summary="@string/ev_bms_status_not_selected" />

	<PreferenceCategory
		android:key="ev_bms_recording"
		android:layout="@layout/preference_category_with_descr"
		android:title="@string/ev_bms_recording" />

	<net.osmand.plus.settings.preferences.ListPreferenceEx
		android:key="ev_bms_poll_interval_ms"
		android:layout="@layout/preference_with_descr"
		android:title="@string/ev_bms_poll_interval" />

	<net.osmand.plus.settings.preferences.SwitchPreferenceEx
		android:key="ev_bms_record_telemetry"
		android:layout="@layout/preference_with_descr_dialog_and_switch"
		android:summaryOff="@string/shared_string_disabled"
		android:summaryOn="@string/shared_string_enabled"
		android:title="@string/ev_bms_record_telemetry" />

	<Preference
		android:key="ev_bms_csv_folder"
		android:layout="@layout/preference_with_descr"
		android:persistent="false"
		android:title="@string/ev_bms_csv_folder" />

	<Preference
		android:key="ev_bms_export_csv"
		android:layout="@layout/preference_with_descr"
		android:persistent="false"
		android:title="@string/ev_bms_export_csv"
		android:summary="@string/ev_bms_export_csv_desc" />

	<PreferenceCategory
		android:key="ev_bms_voice"
		android:layout="@layout/preference_category_with_descr"
		android:title="@string/ev_bms_voice" />

	<net.osmand.plus.settings.preferences.SwitchPreferenceEx
		android:key="ev_bms_announce_soc"
		android:layout="@layout/preference_with_descr_dialog_and_switch"
		android:summaryOff="@string/shared_string_disabled"
		android:summaryOn="@string/shared_string_enabled"
		android:title="@string/ev_bms_announce_soc" />

	<net.osmand.plus.settings.preferences.ListPreferenceEx
		android:key="ev_bms_soc_step_percent"
		android:layout="@layout/preference_with_descr"
		android:title="@string/ev_bms_soc_step" />

	<net.osmand.plus.settings.preferences.SwitchPreferenceEx
		android:key="ev_bms_announce_range_on_stop"
		android:layout="@layout/preference_with_descr_dialog_and_switch"
		android:summaryOff="@string/shared_string_disabled"
		android:summaryOn="@string/shared_string_enabled"
		android:title="@string/ev_bms_announce_range_on_stop" />

	<net.osmand.plus.settings.preferences.SwitchPreferenceEx
		android:key="ev_bms_announce_range_vs_route"
		android:layout="@layout/preference_with_descr_dialog_and_switch"
		android:summaryOff="@string/shared_string_disabled"
		android:summaryOn="@string/shared_string_enabled"
		android:title="@string/ev_bms_announce_range_vs_route" />

	<net.osmand.plus.settings.preferences.ListPreferenceEx
		android:key="ev_bms_stop_speed_kmh"
		android:layout="@layout/preference_with_descr"
		android:title="@string/ev_bms_stop_speed" />

	<net.osmand.plus.settings.preferences.SwitchPreferenceEx
		android:key="ev_bms_announce_cell_voltage"
		android:layout="@layout/preference_with_descr_dialog_and_switch"
		android:summaryOff="@string/shared_string_disabled"
		android:summaryOn="@string/shared_string_enabled"
		android:title="@string/ev_bms_announce_cell_voltage" />

	<net.osmand.plus.settings.preferences.ListPreferenceEx
		android:key="ev_bms_low_cell_mv"
		android:layout="@layout/preference_with_descr"
		android:title="@string/ev_bms_low_cell" />

	<net.osmand.plus.settings.preferences.ListPreferenceEx
		android:key="ev_bms_critical_cell_mv"
		android:layout="@layout/preference_with_descr"
		android:title="@string/ev_bms_critical_cell" />

	<net.osmand.plus.settings.preferences.ListPreferenceEx
		android:key="ev_bms_cell_alert_interval_sec"
		android:layout="@layout/preference_with_descr"
		android:title="@string/ev_bms_cell_alert_interval" />

	<PreferenceCategory
		android:key="ev_bms_range"
		android:layout="@layout/preference_category_with_descr"
		android:title="@string/ev_bms_range_settings" />

	<net.osmand.plus.settings.preferences.SwitchPreferenceEx
		android:key="ev_bms_use_route_profile"
		android:layout="@layout/preference_with_descr_dialog_and_switch"
		android:summaryOff="@string/shared_string_disabled"
		android:summaryOn="@string/shared_string_enabled"
		android:title="@string/ev_bms_use_route_profile" />

</PreferenceScreen>
