<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/voice_gps_settings_host"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">

	<net.osmand.plus.widgets.TextViewEx
		android:id="@+id/title"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:ellipsize="end"
		android:gravity="center_vertical"
		android:maxLines="1"
		android:minHeight="@dimen/bottom_sheet_list_item_height"
		android:paddingStart="@dimen/content_padding"
		android:paddingEnd="@dimen/content_padding"
		android:text="@string/voice_gps_plugin_name"
		android:textAppearance="@style/TextAppearance.ListItemTitle"
		app:typefaceWeight="medium" />

	<LinearLayout
		android:id="@+id/voice_gps_tabs"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:paddingHorizontal="@dimen/content_padding"
		android:paddingBottom="@dimen/content_padding_small">

		<net.osmand.plus.widgets.TextViewEx
			android:id="@+id/tab_settings"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:background="?android:attr/selectableItemBackground"
			android:gravity="center"
			android:minHeight="40dp"
			android:text="@string/voice_gps_tab_settings"
			app:typefaceWeight="medium" />

		<net.osmand.plus.widgets.TextViewEx
			android:id="@+id/tab_notes"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:background="?android:attr/selectableItemBackground"
			android:gravity="center"
			android:minHeight="40dp"
			android:text="@string/voice_gps_tab_notes"
			app:typefaceWeight="medium" />
	</LinearLayout>

	<View
		android:layout_width="match_parent"
		android:layout_height="1dp"
		android:background="?attr/divider_color_basic" />

	<FrameLayout
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1">

		<FrameLayout
			android:id="@+id/voice_gps_settings_container"
			android:layout_width="match_parent"
			android:layout_height="match_parent" />

		<FrameLayout
			android:id="@+id/voice_gps_notes_container"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:visibility="gone" />

		<FrameLayout
			android:id="@+id/voice_gps_buttons_overlay"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_gravity="bottom" />
	</FrameLayout>
</LinearLayout>
