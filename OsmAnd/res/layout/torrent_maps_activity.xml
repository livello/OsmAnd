<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="#121212"
	android:fitsSystemWindows="true">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical">

		<!-- Compact status strip: rates/state + sort + close -->
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:paddingStart="10dp"
			android:paddingTop="4dp"
			android:paddingEnd="2dp"
			android:paddingBottom="2dp">

			<LinearLayout
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:orientation="vertical">

				<TextView
					android:id="@+id/torrent_status_title"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:ellipsize="end"
					android:maxLines="1"
					android:textColor="#FFFFFF"
					android:textSize="20sp"
					android:textStyle="bold" />

				<TextView
					android:id="@+id/torrent_status_rates"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:ellipsize="end"
					android:maxLines="1"
					android:textColor="#90CAF9"
					android:textSize="18sp" />

				<TextView
					android:id="@+id/torrent_status_meta"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:ellipsize="end"
					android:maxLines="1"
					android:textColor="#B0B0B0"
					android:textSize="16sp" />
			</LinearLayout>

			<androidx.appcompat.widget.AppCompatImageButton
				android:id="@+id/torrent_sort_progress"
				android:layout_width="36dp"
				android:layout_height="36dp"
				android:background="?attr/selectableItemBackgroundBorderless"
				android:contentDescription="@string/torrent_maps_sort_progress"
				android:src="@drawable/ic_action_gsave_dark"
				android:tint="#B0BEC5" />

			<androidx.appcompat.widget.AppCompatImageButton
				android:id="@+id/torrent_sort_size"
				android:layout_width="36dp"
				android:layout_height="36dp"
				android:background="?attr/selectableItemBackgroundBorderless"
				android:contentDescription="@string/torrent_maps_sort_size"
				android:src="@drawable/ic_action_sort_big_to_small"
				android:tint="#B0BEC5" />

			<androidx.appcompat.widget.AppCompatImageButton
				android:id="@+id/torrent_sort_name"
				android:layout_width="36dp"
				android:layout_height="36dp"
				android:background="?attr/selectableItemBackgroundBorderless"
				android:contentDescription="@string/torrent_maps_sort_name"
				android:src="@drawable/ic_action_sort_by_name"
				android:tint="#B0BEC5" />

			<androidx.appcompat.widget.AppCompatImageButton
				android:id="@+id/torrent_nearby"
				android:layout_width="36dp"
				android:layout_height="36dp"
				android:background="?attr/selectableItemBackgroundBorderless"
				android:contentDescription="@string/torrent_maps_nearby_title"
				android:src="@drawable/ic_world_globe_dark"
				android:tint="#80CBC4" />

			<androidx.appcompat.widget.AppCompatImageButton
				android:id="@+id/torrent_close"
				android:layout_width="36dp"
				android:layout_height="36dp"
				android:background="?attr/selectableItemBackgroundBorderless"
				android:contentDescription="@string/shared_string_close"
				android:src="@drawable/ic_action_close"
				android:tint="#EEEEEE" />
		</LinearLayout>

		<TextView
			android:id="@+id/torrent_path_breadcrumb"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:ellipsize="start"
			android:maxLines="1"
			android:paddingHorizontal="10dp"
			android:paddingBottom="4dp"
			android:singleLine="true"
			android:textColor="#80CBC4"
			android:textSize="16sp" />

		<LinearLayout
			android:id="@+id/torrent_queue_bar"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:paddingHorizontal="8dp"
			android:paddingBottom="4dp"
			android:visibility="gone">

			<TextView
				android:id="@+id/torrent_queue_summary"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:paddingVertical="8dp"
				android:textColor="#FFE082"
				android:textSize="15sp" />

			<TextView
				android:id="@+id/torrent_queue_pause"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:background="?attr/selectableItemBackground"
				android:paddingHorizontal="10dp"
				android:paddingVertical="8dp"
				android:text="@string/shared_string_pause"
				android:textColor="#90CAF9"
				android:textSize="16sp" />

			<TextView
				android:id="@+id/torrent_queue_resume"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:background="?attr/selectableItemBackground"
				android:paddingHorizontal="10dp"
				android:paddingVertical="8dp"
				android:text="@string/shared_string_resume"
				android:textColor="#A5D6A7"
				android:textSize="16sp" />

			<TextView
				android:id="@+id/torrent_queue_clear"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:background="?attr/selectableItemBackground"
				android:paddingHorizontal="10dp"
				android:paddingVertical="8dp"
				android:text="@string/shared_string_clear"
				android:textColor="#EF9A9A"
				android:textSize="16sp" />
		</LinearLayout>

		<com.google.android.material.tabs.TabLayout
			android:id="@+id/torrent_tabs"
			android:layout_width="match_parent"
			android:layout_height="44dp"
			android:background="#1E1E1E"
			app:tabIndicatorColor="#42A5F5"
			app:tabMode="fixed"
			app:tabSelectedTextColor="#FFFFFF"
			app:tabTextAppearance="@style/TorrentMapsTabText"
			app:tabTextColor="#9E9E9E" />

		<FrameLayout
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="1">

			<androidx.recyclerview.widget.RecyclerView
				android:id="@+id/torrent_file_list"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:clipToPadding="false"
				android:paddingBottom="80dp" />

			<LinearLayout
				android:id="@+id/torrent_logs_panel"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:orientation="vertical"
				android:visibility="gone">

				<TextView
					android:id="@+id/torrent_logs_clear"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:background="?attr/selectableItemBackground"
					android:gravity="end"
					android:paddingHorizontal="12dp"
					android:paddingVertical="8dp"
					android:text="@string/torrent_maps_logs_clear"
					android:textColor="#90CAF9"
					android:textSize="18sp" />

				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/torrent_logs_list"
					android:layout_width="match_parent"
					android:layout_height="0dp"
					android:layout_weight="1"
					android:clipToPadding="false"
					android:paddingBottom="16dp" />
			</LinearLayout>

			<ScrollView
				android:id="@+id/torrent_settings_panel"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:fillViewport="true"
				android:visibility="gone">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:paddingHorizontal="12dp"
					android:paddingVertical="8dp">

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:paddingVertical="6dp">

						<TextView
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							android:text="@string/torrent_maps_enabled"
							android:textColor="#EEEEEE"
							android:textSize="21sp" />

						<androidx.appcompat.widget.SwitchCompat
							android:id="@+id/torrent_enable"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content" />
					</LinearLayout>

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:paddingVertical="6dp">

						<TextView
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							android:text="@string/torrent_maps_wifi_only"
							android:textColor="#EEEEEE"
							android:textSize="21sp" />

						<androidx.appcompat.widget.SwitchCompat
							android:id="@+id/torrent_wifi_only"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content" />
					</LinearLayout>

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:paddingVertical="6dp">

						<TextView
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							android:text="@string/torrent_maps_seed_charge"
							android:textColor="#EEEEEE"
							android:textSize="21sp" />

						<androidx.appcompat.widget.SwitchCompat
							android:id="@+id/torrent_seed_charge"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content" />
					</LinearLayout>

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:paddingVertical="6dp">

						<TextView
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							android:text="@string/torrent_maps_download_new"
							android:textColor="#EEEEEE"
							android:textSize="21sp" />

						<androidx.appcompat.widget.SwitchCompat
							android:id="@+id/torrent_download_new"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content" />
					</LinearLayout>

					<TextView
						android:id="@+id/torrent_pick_file"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:background="?attr/selectableItemBackground"
						android:paddingVertical="10dp"
						android:text="@string/torrent_maps_path"
						android:textColor="#90CAF9"
						android:textSize="21sp" />

					<TextView
						android:id="@+id/torrent_path_summary"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:paddingBottom="8dp"
						android:textColor="#9E9E9E"
						android:textSize="18sp" />

					<LinearLayout
						android:id="@+id/torrent_topic_row"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:background="?attr/selectableItemBackground"
						android:orientation="vertical"
						android:paddingVertical="8dp">

						<TextView
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:text="@string/torrent_maps_topic_url"
							android:textColor="#EEEEEE"
							android:textSize="21sp" />

						<TextView
							android:id="@+id/torrent_topic_url"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:paddingTop="2dp"
							android:textColor="#9E9E9E"
							android:textSize="18sp" />
					</LinearLayout>

					<TextView
						android:id="@+id/torrent_login_rutracker"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:background="?attr/selectableItemBackground"
						android:paddingVertical="10dp"
						android:text="@string/torrent_maps_rutracker_login"
						android:textColor="#90CAF9"
						android:textSize="21sp"
						android:textStyle="bold" />

					<LinearLayout
						android:id="@+id/torrent_cookie_row"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:background="?attr/selectableItemBackground"
						android:orientation="vertical"
						android:paddingVertical="8dp">

						<TextView
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:text="@string/torrent_maps_rutracker_cookie_manual"
							android:textColor="#EEEEEE"
							android:textSize="21sp" />

						<TextView
							android:id="@+id/torrent_cookie_summary"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:paddingTop="2dp"
							android:textColor="#9E9E9E"
							android:textSize="18sp" />
					</LinearLayout>

					<TextView
						android:id="@+id/torrent_open_nearby"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:background="?attr/selectableItemBackground"
						android:paddingVertical="10dp"
						android:text="@string/torrent_maps_nearby_open"
						android:textColor="#90CAF9"
						android:textSize="21sp"
						android:textStyle="bold" />

					<TextView
						android:id="@+id/torrent_verify_hashes"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:background="?attr/selectableItemBackground"
						android:paddingVertical="10dp"
						android:text="@string/torrent_maps_verify_hashes"
						android:textColor="#90CAF9"
						android:textSize="21sp"
						android:textStyle="bold" />

					<TextView
						android:id="@+id/torrent_verify_status"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:paddingBottom="8dp"
						android:text="@string/torrent_maps_verify_hashes_desc"
						android:textColor="#9E9E9E"
						android:textSize="16sp" />

					<TextView
						android:id="@+id/torrent_refresh_rutracker"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:background="?attr/selectableItemBackground"
						android:paddingVertical="10dp"
						android:text="@string/torrent_maps_refresh_topic"
						android:textColor="#90CAF9"
						android:textSize="21sp" />
				</LinearLayout>
			</ScrollView>
		</FrameLayout>
	</LinearLayout>

	<com.google.android.material.floatingactionbutton.FloatingActionButton
		android:id="@+id/torrent_fab"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="bottom|end"
		android:layout_margin="16dp"
		android:contentDescription="@string/shared_string_control_start"
		app:backgroundTint="#1565C0"
		app:fabSize="mini"
		app:srcCompat="@drawable/ic_action_play_dark"
		app:tint="#FFFFFF" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
