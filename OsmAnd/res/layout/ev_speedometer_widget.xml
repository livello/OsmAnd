<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/ev_speedometer_root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="#FF0B0B0B"
	android:clickable="true"
	android:focusable="true">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:gravity="center"
		android:orientation="vertical"
		android:paddingLeft="12dp"
		android:paddingRight="12dp">

		<androidx.appcompat.widget.AppCompatTextView
			android:id="@+id/ev_speedometer_value"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="1"
			android:autoSizeMaxTextSize="360sp"
			android:autoSizeMinTextSize="72sp"
			android:autoSizeStepGranularity="2sp"
			android:autoSizeTextType="uniform"
			android:fontFamily="sans-serif-thin"
			android:gravity="center"
			android:includeFontPadding="false"
			android:maxLines="1"
			android:text="—"
			android:textColor="#FFF7F7F7"
			app:autoSizeMaxTextSize="360sp"
			app:autoSizeMinTextSize="72sp"
			app:autoSizeStepGranularity="2sp"
			app:autoSizeTextType="uniform" />

		<TextView
			android:id="@+id/ev_speedometer_unit"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="-8dp"
			android:layout_marginBottom="28dp"
			android:fontFamily="sans-serif-light"
			android:includeFontPadding="false"
			android:letterSpacing="0.12"
			android:text="@string/km_h"
			android:textColor="#FF8A8A8A"
			android:textSize="22sp" />

		<TextView
			android:id="@+id/ev_speedometer_source"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="-20dp"
			android:layout_marginBottom="16dp"
			android:fontFamily="sans-serif"
			android:includeFontPadding="false"
			android:letterSpacing="0.18"
			android:textAllCaps="true"
			android:textColor="#FF6E6E6E"
			android:textSize="12sp"
			android:visibility="gone" />
	</LinearLayout>
</FrameLayout>
