<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/lora_osmand_settings_host"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">

	<include layout="@layout/lora_osmand_sheet_header" />

	<View
		android:layout_width="match_parent"
		android:layout_height="1dp"
		android:background="?attr/divider_color_basic" />

	<FrameLayout
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1">

		<FrameLayout
			android:id="@+id/lora_osmand_settings_container"
			android:layout_width="match_parent"
			android:layout_height="match_parent" />

		<LinearLayout
			android:id="@+id/lora_osmand_nodes_page"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:orientation="vertical"
			android:visibility="gone">

		<LinearLayout
			android:id="@+id/lora_osmand_node_filters"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:paddingStart="@dimen/content_padding"
			android:paddingTop="4dp"
			android:paddingEnd="@dimen/content_padding">

			<TextView
				android:id="@+id/lora_osmand_filter_online"
				android:layout_width="wrap_content"
				android:layout_height="36dp"
				android:background="?attr/selectableItemBackgroundBorderless"
				android:contentDescription="@string/lora_osmand_filter_online"
				android:gravity="center"
				android:minWidth="40dp"
				android:text="🟢"
				android:textSize="18sp"
				android:tooltipText="@string/lora_osmand_filter_online" />

			<TextView
				android:id="@+id/lora_osmand_filter_visible"
				android:layout_width="wrap_content"
				android:layout_height="36dp"
				android:background="?attr/selectableItemBackgroundBorderless"
				android:contentDescription="@string/lora_osmand_filter_visible"
				android:gravity="center"
				android:minWidth="40dp"
				android:text="👁"
				android:textSize="18sp"
				android:tooltipText="@string/lora_osmand_filter_visible" />
		</LinearLayout>

		<ScrollView
			android:id="@+id/lora_osmand_nodes_scroll"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="1"
			android:fillViewport="true">

			<LinearLayout
				android:id="@+id/lora_osmand_nodes_list"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:padding="@dimen/content_padding" />
		</ScrollView>
		</LinearLayout>

		<ScrollView
			android:id="@+id/lora_osmand_about"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:fillViewport="true"
			android:visibility="gone">

			<TextView
				android:id="@+id/lora_osmand_about_text"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:lineSpacingMultiplier="1.15"
				android:padding="@dimen/content_padding"
				android:textIsSelectable="true"
				android:textSize="15sp" />
		</ScrollView>

		<LinearLayout
			android:id="@+id/lora_osmand_messages"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:orientation="vertical"
			android:visibility="gone">

			<ScrollView
				android:id="@+id/lora_osmand_chat_scroll"
				android:layout_width="match_parent"
				android:layout_height="0dp"
				android:layout_weight="1"
				android:fillViewport="true">

				<LinearLayout
					android:id="@+id/lora_osmand_messages_column"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical">

					<LinearLayout
						android:id="@+id/lora_osmand_messages_header"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="vertical">

						<LinearLayout
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:gravity="center_vertical"
							android:minHeight="36dp"
							android:orientation="horizontal"
							android:paddingStart="@dimen/content_padding"
							android:paddingEnd="@dimen/content_padding_half">

							<TextView
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:layout_weight="1"
								android:text="@string/lora_osmand_speak_auto"
								android:textColor="?android:textColorPrimary"
								android:textSize="@dimen/default_list_text_size" />

							<androidx.appcompat.widget.SwitchCompat
								android:id="@+id/lora_osmand_speak_switch"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content" />
						</LinearLayout>

						<TextView
							android:id="@+id/lora_osmand_message_status"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:paddingStart="@dimen/content_padding"
							android:paddingTop="4dp"
							android:paddingEnd="@dimen/content_padding"
							android:paddingBottom="8dp"
							android:textColor="?android:textColorSecondary"
							android:textSize="@dimen/default_desc_text_size" />
					</LinearLayout>

					<LinearLayout
						android:id="@+id/lora_osmand_chat"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:paddingStart="@dimen/content_padding"
						android:paddingEnd="@dimen/content_padding"
						android:paddingBottom="@dimen/content_padding" />
				</LinearLayout>
			</ScrollView>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="48dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<TextView
					android:id="@+id/lora_osmand_speak_recent"
					android:layout_width="56dp"
					android:layout_height="match_parent"
					android:background="?attr/selectableItemBackground"
					android:contentDescription="@string/lora_osmand_speak_recent"
					android:gravity="center"
					android:text="🔊"
					android:textSize="20sp"
					android:tooltipText="@string/lora_osmand_speak_recent" />

				<TextView
					android:id="@+id/lora_osmand_compose_open"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:layout_weight="1"
					android:background="?attr/selectableItemBackground"
					android:gravity="center"
					android:text="@string/lora_osmand_compose"
					android:textSize="16sp" />
			</LinearLayout>
		</LinearLayout>
	</FrameLayout>

	<HorizontalScrollView
		android:id="@+id/lora_osmand_jumps"
		android:layout_width="match_parent"
		android:layout_height="36dp"
		android:fillViewport="true"
		android:scrollbars="none"
		android:visibility="gone">

		<LinearLayout
			android:id="@+id/lora_osmand_jump_row"
			android:layout_width="wrap_content"
			android:layout_height="match_parent"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:paddingStart="4dp"
			android:paddingEnd="4dp" />
	</HorizontalScrollView>
</LinearLayout>
