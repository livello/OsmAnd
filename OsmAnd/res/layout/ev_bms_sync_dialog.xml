<?xml version="1.0" encoding="utf-8"?>
<ScrollView 	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:fillViewport="true">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingStart="@dimen/content_padding"
		android:paddingEnd="@dimen/content_padding"
		android:paddingTop="8dp"
		android:paddingBottom="12dp">

		<net.osmand.plus.widgets.TextViewEx
			android:id="@+id/sync_master_section"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="8dp"
			android:paddingBottom="4dp"
			android:text="@string/ev_bms_sync_master_section"
			android:textColor="?android:textColorSecondary"
			android:textSize="@dimen/default_desc_text_size" />

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<net.osmand.plus.widgets.TextViewEx
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@string/ev_bms_sync_master"
				android:textColor="?android:textColorPrimary"
				android:textSize="@dimen/default_list_text_size" />

			<androidx.appcompat.widget.SwitchCompat
				android:id="@+id/sync_master_switch"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content" />
		</LinearLayout>

		<net.osmand.plus.widgets.TextViewEx
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="8dp"
			android:text="@string/ev_bms_sync_port"
			android:textColor="?android:textColorSecondary"
			android:textSize="@dimen/default_desc_text_size" />

		<EditText
			android:id="@+id/sync_port"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:hint="8742"
			android:inputType="number"
			android:maxLines="1" />

		<net.osmand.plus.widgets.TextViewEx
			android:id="@+id/sync_ips"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="4dp"
			android:textColor="?android:textColorPrimary"
			android:textSize="@dimen/default_desc_text_size" />

		<net.osmand.plus.widgets.TextViewEx
			android:id="@+id/sync_master_status"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="4dp"
			android:textColor="?android:textColorSecondary"
			android:textSize="@dimen/default_desc_text_size" />

		<View
			android:layout_width="match_parent"
			android:layout_height="1dp"
			android:layout_marginTop="12dp"
			android:layout_marginBottom="8dp"
			android:background="?attr/divider_color_basic" />

		<net.osmand.plus.widgets.TextViewEx
			android:id="@+id/sync_client_section"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingBottom="4dp"
			android:text="@string/ev_bms_sync_client_section"
			android:textColor="?android:textColorSecondary"
			android:textSize="@dimen/default_desc_text_size" />

		<net.osmand.plus.widgets.TextViewEx
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="@string/ev_bms_sync_host"
			android:textColor="?android:textColorSecondary"
			android:textSize="@dimen/default_desc_text_size" />

		<EditText
			android:id="@+id/sync_host"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:hint="@string/ev_bms_sync_host_hint"
			android:inputType="textUri"
			android:maxLines="1" />

		<Button
			android:id="@+id/sync_now"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:text="@string/ev_bms_sync_now" />

		<ProgressBar
			android:id="@+id/sync_progress"
			style="?android:attr/progressBarStyleHorizontal"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:visibility="gone" />

		<net.osmand.plus.widgets.TextViewEx
			android:id="@+id/sync_progress_text"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="4dp"
			android:textColor="?android:textColorSecondary"
			android:textSize="@dimen/default_desc_text_size" />

		<net.osmand.plus.widgets.TextViewEx
			android:id="@+id/sync_last_result"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="4dp"
			android:textColor="?android:textColorPrimary"
			android:textSize="@dimen/default_desc_text_size" />
	</LinearLayout>
</ScrollView>
