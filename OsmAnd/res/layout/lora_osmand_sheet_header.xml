<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/lora_osmand_sheet_header"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:gravity="center_vertical"
	android:minHeight="@dimen/bottom_sheet_list_item_height"
	android:orientation="horizontal"
	android:paddingStart="@dimen/content_padding"
	android:paddingEnd="4dp">

	<net.osmand.plus.widgets.TextViewEx
		android:id="@+id/title"
		android:layout_width="0dp"
		android:layout_height="match_parent"
		android:layout_weight="1"
		android:ellipsize="end"
		android:gravity="center_vertical"
		android:maxLines="1"
		android:paddingEnd="8dp"
		android:text="@string/lora_osmand_plugin_name"
		android:textAppearance="@style/TextAppearance.ListItemTitle"
		app:typefaceWeight="medium" />

	<TextView
		android:id="@+id/tab_settings"
		android:layout_width="wrap_content"
		android:layout_height="match_parent"
		android:background="?attr/selectableItemBackgroundBorderless"
		android:gravity="center"
		android:includeFontPadding="false"
		android:minWidth="32dp"
		android:paddingStart="3dp"
		android:paddingEnd="3dp"
		android:text="⚙️"
		android:textSize="18sp" />

	<TextView
		android:id="@+id/tab_nodes"
		android:layout_width="wrap_content"
		android:layout_height="match_parent"
		android:background="?attr/selectableItemBackgroundBorderless"
		android:gravity="center"
		android:includeFontPadding="false"
		android:minWidth="32dp"
		android:paddingStart="3dp"
		android:paddingEnd="3dp"
		android:text="📡"
		android:textSize="18sp" />

	<TextView
		android:id="@+id/tab_about"
		android:layout_width="wrap_content"
		android:layout_height="match_parent"
		android:background="?attr/selectableItemBackgroundBorderless"
		android:contentDescription="@string/lora_osmand_about_tab"
		android:gravity="center"
		android:includeFontPadding="false"
		android:minWidth="32dp"
		android:paddingStart="3dp"
		android:paddingEnd="3dp"
		android:text="ℹ️"
		android:textSize="18sp" />

	<TextView
		android:id="@+id/tab_messages"
		android:layout_width="wrap_content"
		android:layout_height="match_parent"
		android:background="?attr/selectableItemBackgroundBorderless"
		android:gravity="center"
		android:includeFontPadding="false"
		android:minWidth="32dp"
		android:paddingStart="3dp"
		android:paddingEnd="6dp"
		android:text="✉️"
		android:textSize="18sp" />

</LinearLayout>
